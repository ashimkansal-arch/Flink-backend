  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  action     String    @db.VarChar(80) // 'provider.approve', 'booking.override_status'
  entityType String?   @map("entity_type") @db.VarChar(40)
  entityId   String?   @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([actorType, actorId], map: "idx_audit_actor")
  @@map("audit_logs")
}

model NotificationCampaign {
  id               String    @id @default(uuid()) @map("campaign_id") @db.Uuid
  title            String    @db.VarChar(80)
  body             String    @db.VarChar(240)
  category         String    @db.VarChar(20)
  tone             String    @db.VarChar(20)
  audience         String    @db.VarChar(20)
