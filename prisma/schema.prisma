/** Public legal/help copy shown on customer and provider login — singleton id = "default". */
model LegalSupportContent {
  id               String   @id @default("default") @db.VarChar(32)
  termsOfService   String   @default("") @map("terms_of_service")
  privacyPolicy    String   @default("") @map("privacy_policy")
  refundPolicy     String   @default("") @map("refund_policy")
  cancellationPolicy String @default("") @map("cancellation_policy")
  pricingAndPayment String  @default("") @map("pricing_and_payment")
  contactEmail     String?  @map("contact_email") @db.VarChar(160)
  contactPhone     String?  @map("contact_phone") @db.VarChar(20)
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid

  faqs LegalSupportFaq[]

  @@map("legal_support_content")
}

model LegalSupportFaq {
  id        String   @id @default(uuid()) @map("faq_id") @db.Uuid
  contentId String   @default("default") @map("content_id") @db.VarChar(32)
  question  String   @db.VarChar(240)
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  content LegalSupportContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, sortOrder], map: "idx_legal_support_faqs_order")
  @@map("legal_support_faqs")
}
