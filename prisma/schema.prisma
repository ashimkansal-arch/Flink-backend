  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, name])
  @@index([stateId], map: "idx_cities_state")
  @@map("cities")
}

// ── Audit Log & Notifications ────────────────────────────────────────────

model AuditLog {
